{
  "name": "lombada",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo --port 5174 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "pages:dev": "npm run build && wrangler dev --port 8788",
    "pages:deploy": "npm run build && wrangler deploy",
    "test:logic": "node tests/server-ai.test.mjs && node tests/lib-logic.test.mjs",
    "test:rls": "node supabase/tests/rls-test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "@fontsource-variable/anybody": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.145.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260930.2": true
  }
}
