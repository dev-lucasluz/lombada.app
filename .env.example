# Copie para .env.local e preencha (Supabase → Project Settings → API Keys / Data API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Chave pública VAPID para web push (fase 2). Gere com: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Chave da Google Books API (opcional, grátis; ~1.000 buscas/dia só para o seu projeto).
# Crie em console.cloud.google.com → APIs → Books API → Credenciais → Chave de API,
# e RESTRINJA a chave: só a Books API e só os endereços do app (localhost:5173 e o publicado).
VITE_GOOGLE_BOOKS_API_KEY=
